# Virtual environments
.venv/
venv/
env/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.so

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Large binary assets, tracked out of band. The provenance record and the
# metrics report are small and ARE tracked: they are what the weights mean.
models/*
!models/PROVENANCE.md
!models/*/
models/*/**
!models/*/validation.json
assets/soundfonts/
*.sf2
*.pt
*.onnx

# Training runs, including the abandoned local CPU run kept for reference
runs/
runs_local_cpu_abandoned/

# Generated datasets, reproducible from their seed
datasets/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
